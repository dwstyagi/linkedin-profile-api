# Copy to .env for local development. Never commit the filled-in file.
# In production these are set as platform secrets (e.g. `fly secrets set ...`).

# --- Our own API -----------------------------------------------------------
# Clients must send this value in the X-API-Key header.
# Generate one with: bin/rails secret | cut -c1-40
API_KEY=replace-me

# --- LinkedIn session ------------------------------------------------------
# Harvested by hand from a logged-in browser, once, during setup.
# See README "Obtaining a LinkedIn session" for the exact steps.
# The running service never launches a browser; it only replays these cookies.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# More reliable alternative: paste the entire Cookie header from a real
# request (DevTools > Network > any linkedin.com request > Copy value of the
# "cookie" request header). This carries bcookie/bscookie/lidc as well, which
# LinkedIn sometimes requires to avoid redirecting the call back to itself.
# When set, this takes precedence over the two variables above.
# LINKEDIN_COOKIE=

# Should match the browser the cookies were taken from.
# LINKEDIN_USER_AGENT=

# --- Tuning ----------------------------------------------------------------
# How long a fetched profile is served from cache before we spend another
# upstream request. Longer is safer for the session.
PROFILE_CACHE_TTL_SECONDS=86400

# Inbound requests allowed per minute, per API key.
THROTTLE_REQUESTS_PER_MINUTE=30

# Outbound protection for the LinkedIn session. A profile costs 6 upstream
# requests, so the interval is the dominant term in uncached response time:
# 2.0s spacing means roughly 13 seconds for a cache miss. Lower it for a
# snappier demo, raise it to be gentler on the account.
LINKEDIN_MIN_REQUEST_INTERVAL=2.0
LINKEDIN_DAILY_REQUEST_LIMIT=100

LINKEDIN_OPEN_TIMEOUT=5
LINKEDIN_READ_TIMEOUT=15

# Override if recon shows LinkedIn has moved the profile endpoint.
# LINKEDIN_PROFILE_PATH=identity/profiles/%{public_identifier}/profileView
